# Slack tokens. See slack/manifest.yaml for the app setup.
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# Bearer token for the HTTP API. Generate with:
#   openssl rand -hex 32
FOGHORN_API_TOKEN=

# Optional: override the default Slack alert channel (#alerts).
# FOGHORN_ALERT_CHANNEL=#alerts

# Optional: enable email alerts via SMTP. SMTP_HOST gates the sink;
# when set, every other SMTP_* var is required.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=foghorn-alerts@example.com
# SMTP_PASSWORD=
# SMTP_FROM=foghorn-alerts@example.com
# SMTP_TO=oncall@example.com,backup@example.com

# Optional: enable PagerDuty alerts via the Events API v2.
# PAGERDUTY_ROUTING_KEY gates the sink. PAGERDUTY_SEVERITIES is an
# optional comma-separated allow-list; default is "critical" only.
# PAGERDUTY_ROUTING_KEY=
# PAGERDUTY_SEVERITIES=critical
